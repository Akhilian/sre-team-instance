{
  "name": "sre-team-instance",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:http": "vitest run --config vitest.http.config.ts",
    "k8s:up": "bash deploy/local.sh up",
    "k8s:up:ollama": "bash deploy/local.sh up --ollama",
    "k8s:down": "bash deploy/local.sh down"
  },
  "dependencies": {
    "ioredis": "^5.11.1",
    "nuxt": "^4.6.2",
    "unstorage": "^1.17.6",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "typescript": "~6.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
